{
  "name": "hotplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live Pi skill analytics with local SQLite and optional authenticated LAN aggregation.",
  "exports": {
    ".": "./dist/src/index.js",
    "./extension": "./dist/src/extension.js",
    "./server": "./dist/src/server.js"
  },
  "bin": {
    "hotplate": "./dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "docs/",
    "examples/",
    "src/",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": ["./src/extension.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "check": "npm run typecheck && npm test && npm run test:deploy && npm run test:dashboard-preview",
    "test:deploy": "node --test test/unraid-deploy.test.mjs",
    "smoke:unraid": "node scripts/unraid-deploy-smoke.mjs && node scripts/unraid-deploy-smoke.mjs --regressions",
    "pack:dry": "npm pack --dry-run",
    "dashboard": "npm run build && node dist/src/cli.js serve",
    "dashboard:demo": "npm run build && node dist/src/cli.js demo --db ./dist/demo/hotplate-demo.sqlite --force",
    "dashboard:preview": "npm run build && node scripts/dashboard-preview.mjs",
    "test:dashboard-preview": "npm run build && node --test test/dashboard-preview.test.mjs",
    "smoke:dashboard": "npm run build && node scripts/dashboard-browser-smoke.mjs"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
