{
  "name": "hotplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local pi skill analytics storage and collector.",
  "exports": {
    ".": "./dist/src/index.js",
    "./extension": "./dist/src/extension.js",
    "./server": "./dist/src/server.js"
  },
  "bin": {
    "hotplate": "./dist/src/cli.js"
  },
  "pi": {
    "extensions": ["./src/extension.ts"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "dashboard": "npm run build && node dist/src/cli.js serve",
    "dashboard:demo": "npm run build && node dist/src/cli.js demo --db ./dist/demo/hotplate-demo.sqlite --force"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
